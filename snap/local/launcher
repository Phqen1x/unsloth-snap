#!/bin/sh

# WebKit2GTK's bubblewrap-based subprocess sandbox conflicts with snap's own
# seccomp/AppArmor confinement, causing a crash on startup. Disabling
# WebKit's internal sandbox is safe here because snap confinement provides
# equivalent isolation.
export WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1

# WebKitGTK DMABUF renderer SHM fallback for compatibility across GPU drivers
export WEBKIT_DMABUF_RENDERER_FORCE_SHM=1


# Determine architecture triplet
case "$SNAP_ARCH" in
    amd64) arch_triplet="x86_64-linux-gnu" ;;
    armhf) arch_triplet="arm-linux-gnueabihf" ;;
    arm64) arch_triplet="aarch64-linux-gnu" ;;
    ppc64el) arch_triplet="powerpc64le-linux-gnu" ;;
    *) arch_triplet="$SNAP_ARCH-linux-gnu" ;;
esac

# Prefer snap-provided helpers like our xdg-open wrapper, git-core, and bundled uv.
export PATH="$SNAP/usr/lib/git-core:$SNAP/usr/bin:$SNAP/bin:$PATH"

# Git environment for pip/uv VCS dependencies (e.g. triton kernels git+https)
export GIT_EXEC_PATH="$SNAP/usr/lib/git-core"
export GIT_TEMPLATE_DIR="$SNAP/usr/share/git-core/templates"

# SSL certificate paths for Git, Python, and curl inside the snap
if [ -f "/etc/ssl/certs/ca-certificates.crt" ]; then
    export GIT_SSL_CAINFO="/etc/ssl/certs/ca-certificates.crt"
    export SSL_CERT_FILE="/etc/ssl/certs/ca-certificates.crt"
    export CURL_CA_BUNDLE="/etc/ssl/certs/ca-certificates.crt"
elif [ -f "$SNAP/etc/ssl/certs/ca-certificates.crt" ]; then
    export GIT_SSL_CAINFO="$SNAP/etc/ssl/certs/ca-certificates.crt"
    export SSL_CERT_FILE="$SNAP/etc/ssl/certs/ca-certificates.crt"
    export CURL_CA_BUNDLE="$SNAP/etc/ssl/certs/ca-certificates.crt"
fi

# Ensure host driver libraries (like NVIDIA CUDA / libcuda.so.1) and system libs are discoverable
export LD_LIBRARY_PATH="/var/lib/snapd/lib/gl:/usr/lib/${arch_triplet}:/lib/${arch_triplet}:${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Preload affinity wrapper to prevent ROCm / PyTorch crash on restricted sched_setaffinity
if [ -f "$SNAP/usr/lib/libsnap-affinity-wrapper.so" ]; then
    export LD_PRELOAD="$SNAP/usr/lib/libsnap-affinity-wrapper.so${LD_PRELOAD:+:$LD_PRELOAD}"
elif [ -f "$SNAP/usr/lib/$arch_triplet/libsnap-affinity-wrapper.so" ]; then
    export LD_PRELOAD="$SNAP/usr/lib/$arch_triplet/libsnap-affinity-wrapper.so${LD_PRELOAD:+:$LD_PRELOAD}"
fi

# Prevent GNOME extension's host Python 3.12 PYTHONPATH from contaminating
# Unsloth's managed Python 3.13 virtual environment (avoids SRE module mismatch errors)
unset PYTHONPATH

# Ensure Unsloth uses the user common directory for studio installation and caches
export UNSLOTH_STUDIO_HOME="${UNSLOTH_STUDIO_HOME:-$SNAP_USER_COMMON/.unsloth/studio}"
export HF_HOME="${HF_HOME:-$SNAP_USER_COMMON/.cache/huggingface}"

# Keep app data inside the snap user common directory
export XDG_DATA_HOME="$SNAP_USER_COMMON/.local/share"
export XDG_CONFIG_HOME="$SNAP_USER_COMMON/.config"
export XDG_CACHE_HOME="$SNAP_USER_COMMON/.cache"
export XDG_STATE_HOME="$SNAP_USER_COMMON/.local/state"
export GIO_MODULE_DIR="$XDG_CACHE_HOME/gio-modules"

mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME" "$UNSLOTH_STUDIO_HOME" "$HF_HOME"

# Ensure dconf database and desktop environment configs (GTK themes, fontconfig, etc.)
# prepared by desktop-launch or host are available under XDG_CONFIG_HOME ($SNAP_USER_COMMON/.config).
mkdir -p "$XDG_CONFIG_HOME/dconf"
if [ -e "$SNAP_REAL_HOME/.config/dconf/user" ]; then
    ln -sf "$SNAP_REAL_HOME/.config/dconf/user" "$XDG_CONFIG_HOME/dconf/user"
elif [ -e "$SNAP_USER_DATA/.config/dconf/user" ]; then
    ln -sf "$SNAP_USER_DATA/.config/dconf/user" "$XDG_CONFIG_HOME/dconf/user"
fi

for dir in fontconfig gtk-2.0 gtk-3.0 gtk-4.0 ibus; do
    src_dir=""
    if [ -d "$SNAP_USER_DATA/.config/$dir" ]; then
        src_dir="$SNAP_USER_DATA/.config/$dir"
    elif [ -d "$SNAP_REAL_HOME/.config/$dir" ]; then
        src_dir="$SNAP_REAL_HOME/.config/$dir"
    fi
    if [ -n "$src_dir" ]; then
        mkdir -p "$XDG_CONFIG_HOME/$dir"
        for f in "$src_dir"/*; do
            [ -e "$f" ] || [ -L "$f" ] || continue
            fname="$(basename "$f")"
            if [ ! -e "$XDG_CONFIG_HOME/$dir/$fname" ] && [ ! -L "$XDG_CONFIG_HOME/$dir/$fname" ]; then
                ln -sf "$f" "$XDG_CONFIG_HOME/$dir/$fname"
            fi
        done
    fi
done

# Synchronize dark mode preference into GTK settings fallback if not already set
is_dark=0
if command -v gsettings >/dev/null 2>&1; then
    cs="$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | tr -d "'\"")"
    if [ "$cs" = "prefer-dark" ]; then
        is_dark=1
    fi
    if [ "$is_dark" -eq 0 ]; then
        theme="$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'\"")"
        case "$theme" in
            *[Dd]ark*) is_dark=1 ;;
        esac
    fi
fi

if [ "$is_dark" -eq 1 ]; then
    for gtk_ver in gtk-3.0 gtk-4.0; do
        ini="$XDG_CONFIG_HOME/$gtk_ver/settings.ini"
        if [ ! -s "$ini" ]; then
            rm -f "$ini"
            mkdir -p "$XDG_CONFIG_HOME/$gtk_ver"
            cat << 'EOF' > "$ini"
[Settings]
gtk-application-prefer-dark-theme = 1
EOF
        fi
    done
else
    for gtk_ver in gtk-3.0 gtk-4.0; do
        ini="$XDG_CONFIG_HOME/$gtk_ver/settings.ini"
        if [ -f "$ini" ] && grep -q "gtk-application-prefer-dark-theme = 1" "$ini" && [ "$(wc -l < "$ini")" -le 3 ]; then
            rm -f "$ini"
        fi
    done
fi

# Clear stale GIO module cache. The GNOME extension caches GIO modules to
# $SNAP_USER_COMMON/.cache/gio-modules/ from the previous snap revision.
# libgiolibproxy.so in that cache references libpxbackend-1.0.so via an
# absolute RUNPATH that doesn't resolve across revisions; rebuilding the cache
# here keeps GIO modules (including TLS) available for this run.
gio_module_dir="${GIO_MODULE_DIR:-${XDG_CACHE_HOME:-$SNAP_USER_COMMON/.cache}/gio-modules}"

if [ -n "${SNAP_DESKTOP_RUNTIME:-}" ]; then
    gio_runtime_libdir="$SNAP_DESKTOP_RUNTIME/usr/lib/$arch_triplet"
    gio_querymodules="$gio_runtime_libdir/glib-2.0/gio-querymodules"
    if [ -x "$gio_querymodules" ]; then
        if [ ! -f "$gio_module_dir/.snap-rev-$SNAP_REVISION" ] || [ ! -e "$gio_module_dir/libgiognutls.so" ]; then
            rm -rf "$gio_module_dir"
            mkdir -p "$gio_module_dir"
            for module in "$gio_runtime_libdir"/gio/modules/*.so; do
                if command -v ldd >/dev/null 2>&1; then
                    if ldd "$module" 2>/dev/null | grep -q "not found"; then
                        continue
                    fi
                fi
                ln -s "$module" "$gio_module_dir"/
            done
            "$gio_querymodules" "$gio_module_dir"
            touch "$gio_module_dir/.snap-rev-$SNAP_REVISION"
        fi
    fi
fi

exec "$@"
